# Required: get this from https://resend.com/api-keys after creating a free account.
RESEND_API_KEY=

# Optional: where form submissions are delivered. Defaults to info@sevenskys.co if unset.
RESEND_TO_EMAIL=info@sevenskys.co

# Optional: the "from" address emails are sent as. Works out of the box with Resend's
# shared test sender (onboarding@resend.dev). For better deliverability and branding,
# verify sevenskys.co in the Resend dashboard, then set this to an address on that
# domain, e.g. "SevenSkys Website <enquiries@sevenskys.co>".
RESEND_FROM_EMAIL=SevenSkys Website <onboarding@resend.dev>
